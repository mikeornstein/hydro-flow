{
  "version": "0.1.0",
  "tolerance": {
    "flowRelative": 0.01,
    "pressureRelative": 0.01
  },
  "assumptions": {
    "fluid": "water-20C",
    "rho": 998.2,
    "mu": 0.001002,
    "g": 9.80665,
    "Patm": 101325.0,
    "friction": "Swamee-Jain for Re>=2300; 64/Re laminar",
    "eps_m": 4.5e-5,
    "notes": "Boundary pFixed already includes Patm + rho g elevation so link models should treat geometry.L/D/eps/K only and must NOT add elevation twice. If a solver applies rho g dz from node elevations, drop the hydrostatic part from pFixed (use Patm only)."
