{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikeornstein/hydro-flow/docs/schema/hydroflow.project.schema.json",
  "title": "HydroFlowProject",
  "description": "Versioned project file for hydro-flow. Matches src/engine/types.ts. SI internally.",
  "type": "object",
  "required": ["version", "meta", "units", "fluids", "analysis", "nodes", "links", "couplings"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "0.1.0" },
    "meta": {
      "type": "object",
      "required": ["name", "description", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "units": {
      "type": "object",
      "required": ["system", "length", "pressure", "flow", "temperature", "power"],
      "additionalProperties": false,
      "properties": {
        "system": { "enum": ["SI", "IP"] },
        "length": { "enum": ["m", "mm", "in", "ft"] },
        "pressure": { "enum": ["Pa", "kPa", "bar", "psi"] },
        "flow": { "enum": ["m3/s", "L/min", "gpm", "cfm"] },
        "temperature": { "enum": ["K", "C", "F"] },
        "power": { "enum": ["W", "kW"] }
      }
    },
    "fluids": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name", "phase", "rho", "mu", "cp", "k", "beta", "Tref"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "phase": { "enum": ["liquid", "gas"] },
          "rho": { "type": "number" },
          "mu": { "type": "number" },
          "cp": { "type": "number" },
          "k": { "type": "number" },
          "beta": { "type": "number" },
          "Tref": { "type": "number" }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["type", "flowRegime", "energy", "gravity", "convergence"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "steady" },
        "flowRegime": { "const": "incompressible" },
        "energy": { "type": "boolean" },
        "gravity": { "type": "boolean" },
        "convergence": {
          "type": "object",
          "required": ["massResidual", "energyResidual", "maxIter", "relaxationP", "relaxationQ"],
          "additionalProperties": false,
          "properties": {
            "massResidual": { "type": "number" },
            "energyResidual": { "type": "number" },
            "maxIter": { "type": "integer" },
            "relaxationP": { "type": "number" },
            "relaxationQ": { "type": "number" }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "kind", "x", "y", "z", "fluid"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["junction", "boundary", "tank"] },
          "name": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "fluid": { "type": "string" },
          "pFixed": { "type": "number" },
          "tFixed": { "type": "number" },
          "mdotSource": { "type": "number" },
          "qSource": { "type": "number" },
          "tee": {
            "type": "object",
            "description": "Junction-only. Sharp 90° tee; branch names the side-branch link, the remaining incident links are the equal-area run. Optional correlation: idelchik (default) or gardel.",
            "required": ["branch"],
            "additionalProperties": false,
            "properties": {
              "branch": { "type": "string" },
              "correlation": {
                "type": "string",
                "enum": ["idelchik", "gardel"],
                "default": "idelchik"
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "fluid", "component"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "fluid": { "type": "string" },
          "component": {
            "type": "object",
            "required": ["type", "lossModel", "geometry", "K"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "pipe", "duct", "orifice", "valve", "pump", "fan",
                  "filter", "generic-resistance", "cold-plate", "hex-stream", "emitter", "logical"
                ]
              },
              "lossModel": {
                "enum": ["darcy-weisbach", "k-factor", "quadratic", "linear"]
              },
              "geometry": {
                "type": "object",
                "required": ["L", "D", "eps"],
                "additionalProperties": false,
                "properties": {
                  "L": { "type": "number" },
                  "D": { "type": "number" },
                  "eps": { "type": "number" },
                  "dZ": { "type": "number" },
                  "A": { "type": "number", "description": "Optional flow area m²; D is then hydraulic diameter only." }
                }
              },
              "K": { "type": "number" },
              "rQuad": { "type": "number" },
              "rLin": { "type": "number" },
              "opening": { "type": "number" },
              "pump": {
                "type": "object",
                "required": ["coeffs"],
                "additionalProperties": false,
                "properties": {
                  "coeffs": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 1
                  },
                  "hMin": { "type": "number" }
                }
              },
              "fan": {
                "type": "object",
                "required": ["coeffs"],
                "additionalProperties": false,
                "properties": {
                  "coeffs": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 1
                  },
                  "dpMin": { "type": "number" }
                }
              },
              "emitter": {
                "type": "object",
                "required": ["k", "x"],
                "additionalProperties": false,
                "properties": {
                  "k": { "type": "number", "exclusiveMinimum": 0 },
                  "x": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "q": { "type": "number" },
              "rTh": { "type": "number" },
              "parallelCount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "couplings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "hotLinkId", "coldLinkId", "ua", "arrangement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "const": "hex" },
          "hotLinkId": { "type": "string" },
          "coldLinkId": { "type": "string" },
          "ua": { "type": "number" },
          "arrangement": { "enum": ["counterflow", "parallel", "crossflow-unmixed"] }
        }
      }
    },
    "modules": {
      "type": "array",
      "description": "Parametric subgraph templates. Instances stamp N copies; Newton sees the expanded graph.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "params"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["u-manifold-pack"] },
          "params": {
            "type": "object",
            "required": ["nChannels", "headerD", "branchD", "branchL", "pitch", "eps"],
            "additionalProperties": false,
            "properties": {
              "nChannels": { "type": "integer", "minimum": 2 },
              "headerD": { "type": "number" },
              "branchD": { "type": "number" },
              "branchL": { "type": "number" },
              "pitch": { "type": "number" },
              "eps": { "type": "number" },
              "tees": { "type": "boolean" },
              "correlation": { "enum": ["idelchik", "gardel"] }
            }
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "description": "N copies of a module sharing params, wired to host nodes via ports.",
      "items": {
        "type": "object",
        "required": ["id", "module", "count", "ports", "x", "y", "fluid"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "module": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "ports": {
            "type": "object",
            "required": ["inlet", "outlet"],
            "additionalProperties": false,
            "properties": {
              "inlet": { "type": "string" },
              "outlet": { "type": "string" }
            }
          },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "fluid": { "type": "string" }
        }
      }
    }
  }
}
